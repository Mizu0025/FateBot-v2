# IRC Server Configuration
SERVER=address
# Use 6697 for the conventional TLS port (TLS defaults on for that port).
PORT=6667
# Force TLS on/off explicitly (defaults to true when PORT=6697, else false).
# TLS=true
CHANNEL=#channel
NICK=nick
TRIGGER_WORD=!trigger

# SASL Authentication (Optional)
# SASL_ACCOUNT=your_account
# SASL_PASSWORD=your_password

# ComfyUI Configuration
COMFYUI_ADDRESS=comfyAddress
COMFYUI_PORT=8188
COMFYUI_DOMAIN_PATH=mock_domain_path
COMFYUI_FOLDER_PATH=/path/to/files/
COMFYUI_WORKFLOW_PATH=src/workflows
MODEL_CONFIG_PATH=modelConfiguration.json

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=false

# ComfyUI service control-plane
COMFYUI_START_POLL_INTERVAL_MS=2000

# Node Environment
# NODE_ENV=development
