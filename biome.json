{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": ["**", "!**/dist/**", "!**/node_modules/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 4,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
	    "enabled": true,
	    "rules": {
	        "preset": "recommended",
	        "complexity": {
	            "useArrowFunction": "off"
	        }
	    }
	}
}
