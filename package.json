{
  "name": "fatebot-ts",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/bot.js",
    "watch": "tsc --watch -p tsconfig.build.json",
    "start": "dotenv -e .env -- ts-node src/bot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format src"
  },
  "dependencies": {
    "@types/node": "24.3.0",
    "@types/uuid": "11.0.0",
    "@types/ws": "8.18.1",
    "dotenv": "17.2.0",
    "envalid": "8.2.0",
    "irc-framework": "4.14.0",
    "sharp": "0.35.4",
    "ts-node": "10.9.2",
    "uuid": "11.1.0",
    "winston": "3.19.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "dotenv-cli": "7.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
